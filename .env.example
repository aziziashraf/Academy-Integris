APP_NAME="Integris Academy"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://academy.integris.my

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Hostinger: hPanel → Databases → MySQL Databases (copy the exact names it shows, e.g. u123456789_academy)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u000000000_academy
DB_USERNAME=u000000000_academy
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Password-reset emails. Hostinger: hPanel → Emails → create e.g. no-reply@integris.my
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@integris.my
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@integris.my"
MAIL_FROM_NAME="${APP_NAME}"

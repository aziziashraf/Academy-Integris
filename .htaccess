# Used when the subdomain's folder is the project root (Hostinger's default).
# Sends every request into /public so .env, vendor/ and app code are never served.
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Let SSL certificate checks reach real files
    RewriteRule ^\.well-known/ - [L]
    RewriteRule ^(\.(?!well-known/)|vendor/|storage/|app/|bootstrap/|config/|database/|resources/|routes/|tests/) - [F,L,NC]
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
Options -Indexes
